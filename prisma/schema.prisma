// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  // The Supabase Auth `sub`. This — not the email — is the account identity:
  // an email can be changed by its owner, and a released address can later be
  // registered by someone else, either of which would silently hand one
  // person's library to another if we keyed on it. Nullable only so rows
  // created before this column existed can be adopted on first sign-in.
  authId String? @unique
  email  String

  // sha256 of the API token. The plaintext is shown once at generation and
  // never stored, so a database read can't be replayed against the webhooks.
  apiTokenHash String?   @unique
  lastSyncAt   DateTime?
  maxConsecutiveDaysOff Int @default(0)
  books        Book[]
  createdAt    DateTime  @default(now())
}

model Book {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  title      String
  author     String?
  source     Source
  // Enforced by a partial unique index in the database migration: a non-null
  // KOReader hash is unique per user. Prisma cannot represent that predicate.
  md5        String?
  coverUrl   String?
  status     BookStatus  @default(NOT_STARTED)
  archivedAt DateTime?
  highlights Highlight[]
  stats      BookStats?
  createdAt  DateTime    @default(now())

  @@unique([userId, title, author, source])
  @@index([userId, archivedAt])
}

model Highlight {
  id            String    @id @default(uuid())
  bookId        String
  book          Book      @relation(fields: [bookId], references: [id])
  text          String
  note          String?
  location      String?
  chapter       String?
  tags          String[]  @default([])
  highlightedAt DateTime?
  dedupeHash    String
  createdAt     DateTime  @default(now())

  @@unique([bookId, dedupeHash])
}

model BookStats {
  id               String     @id @default(uuid())
  bookId           String     @unique
  book             Book       @relation(fields: [bookId], references: [id])
  md5              String
  totalPages       Int
  totalReadTimeSec Int
  totalReadPages   Int
  lastOpenAt       DateTime?
  pageStats        PageStat[]
  updatedAt        DateTime   @updatedAt
}

model PageStat {
  id          String    @id @default(uuid())
  bookStatsId String
  bookStats   BookStats @relation(fields: [bookStatsId], references: [id])
  page        Int
  startTime   DateTime
  durationSec Int
  totalPages  Int

  @@index([bookStatsId, startTime])
}

enum Source {
  KOREADER
}

enum BookStatus {
  NOT_STARTED
  READING
  FINISHED
}
