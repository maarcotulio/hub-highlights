// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  apiToken   String?   @unique
  lastSyncAt DateTime?
  books      Book[]
  createdAt  DateTime  @default(now())
}

model Book {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  title      String
  author     String?
  source     Source
  md5        String?
  coverUrl   String?
  status     BookStatus  @default(NOT_STARTED)
  highlights Highlight[]
  stats      BookStats?
  createdAt  DateTime    @default(now())

  @@unique([userId, title, author, source])
}

model Highlight {
  id            String    @id @default(uuid())
  bookId        String
  book          Book      @relation(fields: [bookId], references: [id])
  text          String
  note          String?
  location      String?
  chapter       String?
  tags          String[]  @default([])
  highlightedAt DateTime?
  dedupeHash    String
  createdAt     DateTime  @default(now())

  @@unique([bookId, dedupeHash])
}

model BookStats {
  id               String     @id @default(uuid())
  bookId           String     @unique
  book             Book       @relation(fields: [bookId], references: [id])
  md5              String
  totalPages       Int
  totalReadTimeSec Int
  totalReadPages   Int
  lastOpenAt       DateTime?
  pageStats        PageStat[]
  updatedAt        DateTime   @updatedAt
}

model PageStat {
  id          String    @id @default(uuid())
  bookStatsId String
  bookStats   BookStats @relation(fields: [bookStatsId], references: [id])
  page        Int
  startTime   DateTime
  durationSec Int
  totalPages  Int

  @@index([bookStatsId, startTime])
}

enum Source {
  KOREADER
}

enum BookStatus {
  NOT_STARTED
  READING
  FINISHED
}
