# Copy to `.env` in this directory, fill it in, then:
#   docker compose -f docker/docker-compose.yml up -d --build
#
# Never commit the filled-in file.

# ---------------------------------------------------------------------------
# The deployment URL — read docs/deploy-self-hosted.md before choosing one.
# ---------------------------------------------------------------------------
# This is the single origin for the whole stack: the address you type in the
# browser, and the SERVER_URL you put in the KOReader plugin.
#
# It is BAKED INTO THE APP IMAGE AT BUILD TIME, recorded in the Content-Security
# -Policy, and written into the database on every cover upload. Changing it
# later means rebuilding the image AND rewriting Book.coverUrl rows — a restart
# will not do it. Pick something you can keep:
#
#   - Reserve the host's IP in your router's DHCP settings first. An address
#     that changes on its own is the usual way this URL "breaks by itself".
#   - Prefer a name over a bare IP (http://hub.local:8000 via mDNS, or an entry
#     in your network's DNS) so moving the stack to another machine later
#     doesn't require a rebuild.
#   - Include the port if it isn't 80/443.
#
# https:// works here too, and is what the KOReader plugin prefers — over
# http:// on your LAN the plugin's API token is readable by anyone else on that
# network. The plugin accepts http:// only for private addresses for that
# reason.
HUB_PUBLIC_URL=http://hub.local:8000

# Which interface Caddy listens on. 0.0.0.0 accepts connections on every
# interface of the host; setting your LAN IP (e.g. 192.168.1.50) refuses
# everything arriving anywhere else. Either way, do NOT create a port-forward
# on your router — that is what would turn this into a public deployment.
HUB_BIND_ADDR=0.0.0.0
HUB_PORT=8000

# ---------------------------------------------------------------------------
# Secrets — generate fresh values, never reuse the examples.
# ---------------------------------------------------------------------------
# Root password for the bundled Postgres.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Signing key for all Supabase JWTs. Minimum 32 characters.
#   openssl rand -hex 32
JWT_SECRET=

# ANON_KEY and SERVICE_ROLE_KEY are JWTs SIGNED WITH THE JWT_SECRET ABOVE — the
# three must be generated together, as a set. Generating them independently, or
# changing JWT_SECRET without reissuing both, breaks auth and storage with
# signature errors that read like something else entirely.
#
# Generate with Supabase's key generator:
#   https://supabase.com/docs/guides/self-hosting/docker#securing-your-services
# ANON_KEY needs the claim {"role": "anon"}, SERVICE_ROLE_KEY {"role": "service_role"}.
#
# ANON_KEY ships in the browser bundle by design. SERVICE_ROLE_KEY bypasses RLS
# entirely — it stays server-side and never goes near the frontend.
ANON_KEY=
SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# SMTP — required for password recovery
# ---------------------------------------------------------------------------
# Sign-up and sign-in send no mail. Password recovery does, and it is the only
# way a locked-out user gets back in, so leaving this blank means "forgot your
# password?" silently goes nowhere. Any provider works (Resend, Postmark,
# SendGrid, Fastmail, your own relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Highlights Hub

# ---------------------------------------------------------------------------
# Image versions
# ---------------------------------------------------------------------------
# Pinned so an upstream release can't change GoTrue's environment variable
# names underneath a working deployment. When bumping these, re-check the auth
# settings in docker-compose.yml against that release's own documentation.
POSTGRES_IMAGE_TAG=15.8.1.060
GOTRUE_IMAGE_TAG=v2.177.0
STORAGE_IMAGE_TAG=v1.25.7
CADDY_IMAGE_TAG=2.8-alpine
