# Copy this file to .env and fill in the values from /dashboard/settings on
# your Highlights Hub deployment. Read once at plugin startup and written
# into the plugin's own KOReader settings (DataStorage:getSettingsDir() ..
# "/hub.lua") — you can still override either value from the plugin's
# Settings dialog on the device if you'd rather not use this file.
SERVER_URL=https://your-app.vercel.app
API_TOKEN=
