# Supabase Postgres (Prisma)
DATABASE_URL=       # pooled connection string (port 6543, ?pgbouncer=true)
DIRECT_URL=         # direct connection string (port 5432, used for migrations)

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Read by supabase/config.toml ([auth] site_url) — the origin your browser
# actually uses to reach the Next.js app, and the allow-list Auth redirects
# are checked against.
SITE_URL=http://localhost:3000
