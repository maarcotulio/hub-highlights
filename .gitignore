# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/reports
/.stryker-tmp

# Agents
.agents
skills-lock.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project-specific
.ai-jail
*:Zone.Identifier

# scratch drop folder for real device exports (Kindle/KOReader) -
# never let a real file land in a commit by accident
/data

/app/generated/prisma

data/*.*
**/__fixtures__/*.*
!lib/parsers/__fixtures__/koreader-annotations.lua
!lib/parsers/__fixtures__/koreader-metadata.lua
!lib/parsers/__fixtures__/koreader-statistics.sqlite3

# build artifacts (hub.koplugin.zip is attached to releases, not committed)
/dist
